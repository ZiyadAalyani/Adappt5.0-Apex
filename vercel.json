{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "backend/public/sentinel.html",
      "excludeFiles": "{frontend/**,backend/public/_expo/**,backend/public/assets/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/sentinel", "destination": "/api/index.js" }
  ]
}
